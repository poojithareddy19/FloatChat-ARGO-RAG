# LLM provider. ollama needs no key and runs locally.

GENERATION__PROVIDER=ollama
GENERATION__MODEL=llama3.1:latest
OLLAMA_BASE_URL=http://localhost:11434

# Database passwords. Nothing is committed with a default: choose your own
# before the first `docker compose up`, because the database is created with
# whatever is here then. Keep them URL-safe (letters, digits, - and _), since
# they are also written into the URLs below.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_PASSWORD=change-me
GDA_RO_PASSWORD=change-me-too

# Connection strings for the loaders, the evaluation harness and a local API.
# The passwords must match the two above.

DATABASE__URL=postgresql://gda:change-me@localhost:5432/gda
DATABASE__READONLY_URL=postgresql://gda_ro:change-me-too@localhost:5432/gda

